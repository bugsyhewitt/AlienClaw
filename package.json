{
  "name": "alienclaw",
  "version": "2026.4.10",
  "description": "AlienClaw — governed multi-agent overlay on OpenClaw",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "setup": "bash install.sh",
    "typecheck": "tsc --noEmit",
    "build-info": "bash scripts/gen-build-info.sh",
    "prestart": "bash scripts/gen-build-info.sh",
    "start": "tsx src/alienclaw/api/main.ts",
    "migrate": "tsx src/alienclaw/api/migrate-cli.ts",
    "test": "pnpm exec vitest run && PYTHONPATH=src pytest && bash scripts/check-testvectors.sh && bash scripts/check-seed-drift.sh"
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "0.73.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "commander": "^15.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "files": [
    "README.md",
    "CLAUDE.md",
    "ROADMAP.md",
    "VISION.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE",
    "docs.acp.md",
    "ALIENCLAW_VERSION",
    "install.sh",
    "installer/",
    "seed/",
    "src/",
    "test/",
    "assets/",
    "git-hooks/",
    "scripts/",
    ".github/"
  ],
  "dependencies": {
    "mysql2": "^3.22.3",
    "tsx": "^4.23.13"
  }
}
